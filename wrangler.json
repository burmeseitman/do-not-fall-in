{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dont-fall-in",
  "main": "src/worker.js",
  "compatibility_date": "2025-02-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "GameRoomHub"
      },
      {
        "name": "LEADERBOARD",
        "class_name": "LeaderboardHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoomHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LeaderboardHub"]
    }
  ]
}
